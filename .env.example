# Only set these when a verified production domain and approved content are ready.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Persistent production PostgreSQL. For migrations/backup use an unpooled direct connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# At least 24 random characters. Used by /api/cron and the worker.
CRON_SECRET=
# Salt hashes session and IP identifiers; use independent random values.
IP_HASH_SALT=
ANALYTICS_HASH_SALT=
# S3-compatible media storage (required in production).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side GA4 reporting only; never prefix these with NEXT_PUBLIC_.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Production enquiries: API key is set as a sensitive Production variable by the Resend integration.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=MAIGE Website <inquiries@maigebio.com>
INQUIRY_TO_EMAIL=info@maigebio.com
# One-time administrator creation; provide only in the command environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional manual backup destination and restore target.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
RESTORE_TARGET=

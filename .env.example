# Only set these when a verified production domain and approved content are ready.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server-side GA4 reporting only; never prefix these with NEXT_PUBLIC_.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Production enquiries: API key is set as a sensitive Production variable by the Resend integration.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=MAIGE Website <inquiries@maigebio.com>
INQUIRY_TO_EMAIL=info@maigebio.com
